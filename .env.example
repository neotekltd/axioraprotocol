NEXT_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb-publishable-key-placeholder
NEXT_PUBLIC_SITE_URL=https://axioraprotocol.com
SUPABASE_SECRET_KEY=server-only-placeholder-never-expose-to-client
RESEND_API_KEY=resend-placeholder-server-only

# Site-wide go-live moment (public, inlined at build time). The header Live
# counter derives elapsed time from this fixed UTC timestamp — never change
# it after launch, or the counter resets for everyone. Production builds
# MUST carry this value (it lives in .env.local / build shell, NOT in
# Cloudflare Worker vars, which are runtime-only and cannot inline it).
NEXT_PUBLIC_AXIORA_LAUNCH_TIMESTAMP=2026-10-04T09:29:17Z

# NOWPayments crypto payment rail (server-only; never NEXT_PUBLIC_, never commit values).
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# ==========================================
# AXIORA DEPOSIT ADDRESSES (empty until supplied; never commit real values)
# ==========================================
BTC_DEPOSIT_ADDRESS=
BNB_DEPOSIT_ADDRESS=
DOGE_DEPOSIT_ADDRESS=
LTC_DEPOSIT_ADDRESS=
ETH_DEPOSIT_ADDRESS=
TRX_DEPOSIT_ADDRESS=
USDT_TRC20_DEPOSIT_ADDRESS=
USDT_BEP20_DEPOSIT_ADDRESS=
USDT_ERC20_DEPOSIT_ADDRESS=

# Homepage presentation source (server-side, never NEXT_PUBLIC).
# HOMEPAGE_DATA_SOURCE=aimex -> authorized external presentation dataset,
#   shown with a SOURCE · AIMEX indicator. Never touches the Axiora ledger.
# HOMEPAGE_DATA_SOURCE=axiora (or unset) -> real Axiora ledger aggregates and
#   confirmed deposits/completed withdrawals.
# HOMEPAGE_DATA_SOURCE=reference -> staging snapshot (labeled DEMO DATA).
HOMEPAGE_DATA_SOURCE=
